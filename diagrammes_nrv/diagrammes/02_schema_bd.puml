
@startuml
hide methods
hide stereotypes
skinparam linetype ortho

entity "Soiree" as soiree {
  * id_soiree : INT <<PK>>
  --
  nom : VARCHAR(100)
  thematique : VARCHAR(100)
  date : DATE
  horaire_debut : TIME
  lieu : VARCHAR(100)
  places_disponibles : INT
  prix : DECIMAL(10,2)
}

entity "Spectacle" as spectacle {
  * id_spectacle : INT <<PK>>
  --
  id_soiree : INT <<FK>>
  titre : VARCHAR(100)
  description : TEXT
  genre : VARCHAR(50)
  image : VARCHAR(255)
  video : VARCHAR(255)
  creneau : TIME
}

entity "Spectacle_Artiste" as spectacle_artiste {
  * id_spectacle : INT <<PK, FK>>
  * id_artiste : INT <<PK, FK>>
}

entity "Artiste" as artiste {
  * id_artiste : INT <<PK>>
  --
  nom : VARCHAR(100)
  information : TEXT
  genre : VARCHAR(50)
}

entity "Utilisateur" as utilisateur {
  * id_utilisateur : INT <<PK>>
  --
  nom : VARCHAR(50)
  prenom : VARCHAR(50)
  email : VARCHAR(100) <<UNIQUE>>
  password : VARCHAR(255)
}

entity "Commande" as commande {
  * id_commande : INT <<PK>>
  --
  id_utilisateur : INT <<FK>>
  montant_total : DECIMAL(10,2)
  date : DATETIME
  statut : ENUM
}

entity "Panier" as panier {
  * id_panier : INT <<PK>>
  --
  id_commande : INT <<FK>>
  id_soiree : INT <<FK>>
  type_tarif : ENUM
  quantite : INT
}

entity "Billet" as billet {
  * id_billet : INT <<PK>>
  --
  id_commande : INT <<FK>>
  id_soiree : INT <<FK>>
  reference : VARCHAR(50) <<UNIQUE>>
  token : VARCHAR(64) <<UNIQUE>>
  categorie_tarif : ENUM
}

soiree ||--|{ spectacle : contient 1 a 3
spectacle ||--|{ spectacle_artiste : associe
artiste ||--|{ spectacle_artiste : participe
utilisateur ||--o{ commande : passe
commande ||--o{ panier : contient
soiree ||--o{ panier : concerne
commande ||--o{ billet : contient
soiree ||--o{ billet : concerne

@enduml

